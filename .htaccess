# ============================================================
# .htaccess — statische Seite spektrum-nachhilfe.de, Apache
# ============================================================

# --- HTTPS erzwingen -----------------------------------------
RewriteEngine On
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

# --- Sicherheits-Header --------------------------------------
<IfModule mod_headers.c>
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; form-action 'self'; frame-ancestors 'none'; base-uri 'self'; object-src 'none'"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), camera=(), microphone=(), payment=(), usb=()"
  Header always set Cross-Origin-Opener-Policy "same-origin"

  # ERST aktivieren, wenn HTTPS zuverlaessig laeuft. Ruecknahme dauert Monate.
  # Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"

  # Browser darf HTML behalten, muss aber vor dem Anzeigen kurz nachfragen —
  # bei unveraenderter Datei antwortet der Server mit 304, das kostet nichts.
  <FilesMatch "\.html$">
    Header always set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>

  Header unset X-Powered-By
</IfModule>

# --- Verzeichnis-Listing aus ---------------------------------
Options -Indexes

# --- Sensible Dateien sperren --------------------------------
<FilesMatch "(^\.|\.(env|git|bak|sql|log|ini|md|json|yml|yaml|sh|zip|tar|gz)$)">
  Require all denied
</FilesMatch>
<Files ".htaccess">
  Require all denied
</Files>

# --- Fehlerseiten --------------------------------------------
ErrorDocument 403 /index.html
ErrorDocument 404 /index.html

# --- Zeichensatz ---------------------------------------------
AddDefaultCharset UTF-8

# --- Komprimierung -------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript image/svg+xml
</IfModule>

# --- Browser-Zwischenspeicher --------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css                "access plus 1 year"
  ExpiresByType application/javascript  "access plus 1 year"
  ExpiresByType image/webp              "access plus 1 year"
  ExpiresByType image/svg+xml           "access plus 1 year"
  ExpiresByType image/x-icon            "access plus 1 year"
  # HTML nie blind zwischenspeichern: der Adminbereich schreibt projekte.html
  # neu, und eine Stunde alter Stand im Browser waere schwer zu erklaeren.
  ExpiresByType text/html               "access plus 0 seconds"
</IfModule>
