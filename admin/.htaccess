# Adminbereich — zusätzlicher Riegel neben der Passwortabfrage in PHP.

Options -Indexes

# Datendateien und Sicherungen sind nie über den Browser abrufbar
<FilesMatch "\.(json|log|bak|neu)$">
  Require all denied
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

# kern.php wird nur eingebunden, nie direkt aufgerufen
<Files "kern.php">
  Require all denied
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</Files>

<IfModule mod_headers.c>
  Header always set X-Robots-Tag "noindex, nofollow"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "no-referrer"
</IfModule>

# Optional: Zugang zusätzlich auf eigene IP-Adressen begrenzen.
# Dann die drei Zeilen entfernen und die eigene Adresse eintragen.
# <RequireAll>
#   Require ip 203.0.113.7
# </RequireAll>
